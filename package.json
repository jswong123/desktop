{
  "name": "frontline-1937-1945",
  "version": "1.6.3",
  "private": true,
  "description": "战线 1937–1945 桌面版与AI学习记录",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.frontline.strategy",
    "productName": "战线 1937-1945",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "electron/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Frontline-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Frontline-Portable-${version}.${ext}"
    }
  }
}